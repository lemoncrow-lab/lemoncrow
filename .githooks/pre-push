#!/bin/sh
# Pre-push gate: the checks in .lemoncrow/environment.toml that the pushed commits
# touch, run by this checkout's own client (`lc verify --pre-push`).
#
#   git push              checks the commits being pushed
#   .githooks/pre-push    checks HEAD + uncommitted work against origin/main
#   make verify-all       runs every check, as if every file changed
cd "$(git rev-parse --show-toplevel)" || exit 2
PYTHONPATH=client/src exec uv run --quiet python -m lemoncrow_client verify --pre-push "$@"
