{
  "name": "@lemoncrow/frontend",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/shared.ts",
    "./styles": "./src/index.css",
    "./ui/*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3125",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3125",
    "typecheck": "tsc",
    "test": "node ./scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:perf:product": "playwright test -c playwright.perf.product.config.ts",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "check:ui-primitives": "node ./scripts/check-ui-primitives.mjs",
    "pretest": "npm run check:ui-primitives",
    "prebuild": "npm run check:ui-primitives"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@pierre/diffs": "1.4.1",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-symbols/icons": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "github-markdown-css": "^5.9.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.57.0",
    "pdfjs-dist": "^6.3.289",
    "posthog-js": "^1.150.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "tailwind-merge": "^2.6.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.5"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
