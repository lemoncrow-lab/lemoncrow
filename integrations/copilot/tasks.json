{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LemonCrow: Copilot Preflight",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "lemoncrow tools call context --args \"{\\\"task\\\":\\\"$1\\\"}\\\" --json",
        "bash",
        "${input:lemoncrowTask}",
        "${input:lemoncrowStep1}",
        "${input:lemoncrowStep2}"
      ],
      "problemMatcher": []
    },
    {
      "label": "LemonCrow: Task Context",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "lemoncrow tools call context --args \"{\\\"task\\\":\\\"$1\\\"}\\\" --json",
        "bash",
        "${input:lemoncrowTask}",
        "${input:lemoncrowStep1}",
        "${input:lemoncrowStep2}"
      ],
      "problemMatcher": []
    },
    {
      "label": "LemonCrow: Record Trace",
      "type": "shell",
      "command": "lemoncrow",
      "args": [
        "runs",
        "record",
        "--task",
        "${input:lemoncrowTask}",
        "--status",
        "partial",
        "--json"
      ],
      "problemMatcher": []
    },
    {
      "label": "LemonCrow: Session Summary",
      "type": "shell",
      "command": "lemoncrow",
      "args": [
        "session",
        "report",
        "--no-color"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "lemoncrowTask",
      "type": "promptString",
      "description": "LemonCrow task description"
    },
    {
      "id": "lemoncrowStep1",
      "type": "promptString",
      "description": "Plan step 1"
    },
    {
      "id": "lemoncrowStep2",
      "type": "promptString",
      "description": "Plan step 2"
    }
  ]
}
