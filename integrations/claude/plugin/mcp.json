{
  "mcpServers": {
    "lemoncrow": {
      "command": "lc",
      "args": ["mcp", "--host", "claude"],
      "env": {
        "LEMONCROW_MCP_TOOL_PROFILE": "core"
      },
      "alwaysAllow": [
        "bash",
        "code_search",
        "compact",
        "context",
        "edit",
        "grep",
        "memory",
        "read",
        "relations",
        "tool",
        "verify",
        "web_fetch"
      ]
    }
  }
}
